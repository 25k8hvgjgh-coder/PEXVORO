{
  "expo": {
    "name": "ReconFeed",
    "slug": "reconfeed",
    "owner": "azzholejr06",
    "scheme": "reconfeed",
    "version": "1.0.4",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reconfeed.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos and videos to share or edit in ReconFeed.",
        "NSCameraUsageDescription": "Record content to share in ReconFeed.",
        "NSMicrophoneUsageDescription": "Record audio with your videos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.reconfeed.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#090b08",
        "foregroundImage": "./assets/icon.png"
      },
      "versionCode": 28
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ReconFeed to select photos and videos.",
          "cameraPermission": "Allow ReconFeed to record content."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/cb631cf4-5781-426a-a5f9-9d3c52abf8dc",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "cb631cf4-5781-426a-a5f9-9d3c52abf8dc"
      }
    },
    "icon": "./assets/icon.png"
  }
}
