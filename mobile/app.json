{
  "expo": {
    "name": "ReconFeed",
    "slug": "reconfeed",
    "owner": "azzholejr06",
    "scheme": "reconfeed",
    "version": "1.0.7",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reconfeed.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos or videos for a post, profile photo or issue report. ReconFeed uploads only when you submit.",
        "NSCameraUsageDescription": "Use your camera only when you choose to take a photo or record a video.",
        "NSMicrophoneUsageDescription": "Use your microphone only to record sound when you choose to capture a video.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.reconfeed.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "versionCode": 33,
      "adaptiveIcon": {
        "backgroundColor": "#090b08",
        "foregroundImage": "./assets/icon.png"
      },
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.READ_CALL_LOG"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos or videos for a post, profile photo or issue report. ReconFeed uploads only when you submit.",
          "cameraPermission": "Use your camera only when you choose to take a photo or record a video.",
          "microphonePermission": "Use your microphone only to record sound when you choose to capture a video."
        }
      ],
      "./plugins/withImmersiveNavigation"
    ],
    "updates": {
      "url": "https://u.expo.dev/cb631cf4-5781-426a-a5f9-9d3c52abf8dc",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "cb631cf4-5781-426a-a5f9-9d3c52abf8dc"
      }
    },
    "icon": "./assets/icon.png",
    "androidNavigationBar": {
      "enforceContrast": false
    }
  }
}
